# Variables usadas por docker-compose.yml (Postgres/Redis de desarrollo) y por
# docker-compose.prod.yml (stack completo). No usar "$" en estos valores: Compose
# interpola $VAR dentro del propio archivo .env de la raíz.
DB_USER=aura
DB_PASSWORD=aura
DB_NAME=aura_inventario

# Solo usado por docker-compose.prod.yml: puerto del host donde queda expuesto
# el frontend (nginx). El backend no se expone directamente, solo vía /api/
# a través del frontend.
HTTP_PORT=80
