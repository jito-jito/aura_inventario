PORT=3000
NODE_ENV=development

# Base de datos (debe coincidir con docker-compose.yml en la raíz del repo)
DB_HOST=localhost
DB_PORT=5432
DB_USER=aura
DB_PASSWORD=aura
DB_NAME=aura_inventario

# Auth admin (MVP: un solo administrador, sin gestión de roles)
ADMIN_EMAIL=admin@example.com
# Hash bcrypt de la contraseña. Generarlo con:
# node -e "console.log(require('bcrypt').hashSync('TU_CLAVE', 10))"
ADMIN_PASSWORD_HASH=$2b$10$b47lU95be6onEYCn.Dh2CuWhWkcpBJ0hsjtC3scgd6PkbgxQ03zsy

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Mercado Libre OAuth (crear la app en https://developers.mercadolibre.com.ar/devcenter)
# MELI_REDIRECT_URI debe configurarse igual en el panel de la app y apuntar al backend.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://localhost:3000/ml/auth/callback
# Dominio de autorización según el sitio del vendedor (.com.ar, .com.mx, .com.br, etc.)
MELI_AUTH_URL=https://auth.mercadolibre.com.ar/authorization

# URL del frontend, usada para redirigir de vuelta tras el callback de OAuth
FRONTEND_URL=http://localhost:4300

# Clave para cifrar los tokens de Mercado Libre en la base de datos (cualquier string largo y secreto)
ML_TOKEN_ENCRYPTION_KEY=change-me-in-production
