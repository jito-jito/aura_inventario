PORT=3000
NODE_ENV=development

# Base de datos (debe coincidir con docker-compose.yml en la raíz del repo)
DB_HOST=localhost
DB_PORT=5432
DB_USER=aura
DB_PASSWORD=aura
DB_NAME=aura_inventario

# Auth admin (MVP: un solo administrador, sin gestión de roles)
ADMIN_EMAIL=admin@example.com
# Hash bcrypt de la contraseña. Generarlo con:
# node -e "console.log(require('bcrypt').hashSync('TU_CLAVE', 10))"
ADMIN_PASSWORD_HASH=$2b$10$b47lU95be6onEYCn.Dh2CuWhWkcpBJ0hsjtC3scgd6PkbgxQ03zsy

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Mercado Libre OAuth (crear la app en https://developers.mercadolibre.com.ar/devcenter)
# MELI_REDIRECT_URI debe configurarse igual en el panel de la app y apuntar al backend.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://localhost:3000/ml/auth/callback
# Dominio de autorización según el sitio del vendedor (.com.ar, .com.mx, .com.br, etc.)
MELI_AUTH_URL=https://auth.mercadolibre.com.ar/authorization

# URL del frontend, usada para redirigir de vuelta tras el callback de OAuth
FRONTEND_URL=http://localhost:4200

# Clave para cifrar los tokens de Mercado Libre en la base de datos (cualquier string largo y secreto)
ML_TOKEN_ENCRYPTION_KEY=change-me-in-production

# Redis (debe coincidir con docker-compose.yml en la raíz del repo). Usado por BullMQ
# para procesar las notificaciones (webhooks) de órdenes de Mercado Libre.
REDIS_HOST=localhost
REDIS_PORT=6379
# Solo hace falta si el Redis de destino requiere autenticación (por ejemplo, el Redis
# gestionado de un PaaS como Railway). El Redis local de docker-compose no la pide.
REDIS_PASSWORD=

# Respaldos de la base de datos (requiere pg_dump instalado, paquete postgresql-client)
# Carpeta donde se guardan los .sql.gz. En un despliegue con Docker debería ser un
# volumen montado (y sincronizarse a un disco/bucket externo para protegerse ante
# fallas del disco local).
BACKUP_DIR=./backups
# Cuántos respaldos recientes conservar (se borran los más viejos automáticamente)
BACKUP_RETENTION_COUNT=14
# Poner en "false" para desactivar el respaldo automático nocturno (03:00)
BACKUP_CRON_ENABLED=true
